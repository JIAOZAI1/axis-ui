{
  "name": "@jiaozai1/axis-ui",
  "version": "0.10.0",
  "description": "企业级 Vue 3 组件库,基于设计 Token 体系构建,支持暗色模式与主题定制",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaozai1/axis-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/axis-ui.umd.cjs",
  "module": "./dist/axis-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/axis-ui.js",
      "require": "./dist/axis-ui.umd.cjs"
    },
    "./dist/axis-ui.css": "./dist/axis-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:lib": "npm run typecheck && vite build --mode lib",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "vue3",
    "component-library",
    "design-tokens",
    "ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7"
  }
}
